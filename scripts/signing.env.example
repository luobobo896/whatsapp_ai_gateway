# 拷成 scripts/signing.env 后按账号改（signing.env 不要提交）。
# 同一套 scripts/package-wda-ipa.sh，靠 SIGN_MODE 切换。

# personal = 个人付费开发者账号（Apple Developer Program）
#   描述文件会列出已登记 UDID，新机必须先登记再重新出包。
SIGN_MODE=personal
# TEAM=A3JP3VUZ78
# IDENTITY=Apple Development: Name (TEAMID)

# enterprise = 企业账号 In-House（Apple Developer Enterprise Program）
#   描述文件必须 ProvisionsAllDevices，不绑设备。只给本公司员工装。
# SIGN_MODE=enterprise
# TEAM=XXXXXXXXXX
# IDENTITY=iPhone Distribution: Example Co
# PROFILE_SPECIFIER=WDA InHouse
# 或：
# PROFILE=/secure/path/WDA_InHouse.mobileprovision
