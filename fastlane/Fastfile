opt_out_usage
desc "验证：用已登记 UDID 生成 development profile（个人开发者自动签名前置）"
lane :sign do
  api_key = {
    key_id: ENV.fetch("FASTLANE_KEY_ID"),
    issuer_id: ENV.fetch("FASTLANE_ISSUER_ID"),
    key: File.read(ENV.fetch("FASTLANE_API_KEY_PATH")),
    duration: 1200,
    in_house: false   # 个人开发者（非企业 In-House）
  }
  cert(development: true, api_key: api_key, team_id: ENV.fetch("FASTLANE_TEAM_ID"))
  sigh(
    development: true,
    app_identifier: ENV.fetch("WDA_BUNDLE_ID", "com.wda.WebRunner"),
    api_key: api_key,
    output_path: "/tmp/wda-test.mobileprovision",
    skip_certificate_verification: true
  )
end

desc "个人账号：注册新 UDID 到团队 → 生成 Development profile（自动签名核心）"
lane :register_and_sign do |options|
  udid = options[:udid]
  name = options[:name] || "user-iphone"
  api_key = {
    key_id: ENV.fetch("FASTLANE_KEY_ID"),
    issuer_id: ENV.fetch("FASTLANE_ISSUER_ID"),
    key: File.read(ENV.fetch("FASTLANE_API_KEY_PATH")),
    duration: 1200,
    in_house: false
  }
  register_device(
    udid: udid,
    name: name,
    api_key: api_key,
    team_id: ENV.fetch("FASTLANE_TEAM_ID")
  )
  cert(development: true, api_key: api_key, team_id: ENV.fetch("FASTLANE_TEAM_ID"))
  sigh(
    development: true,
    app_identifier: ENV.fetch("WDA_BUNDLE_ID", "com.wda.WebRunner"),
    api_key: api_key,
    output_path: "/tmp/wda-auto.mobileprovision",
    skip_certificate_verification: true
  )
  puts "✅ 已注册 #{udid} 并生成 profile：/tmp/wda-auto.mobileprovision"
end

desc "为指定团队生成/导入 Apple Development 证书到钥匙串（identity）"
lane :cert_force do
  api_key = {
    key_id: ENV.fetch("FASTLANE_KEY_ID"),
    issuer_id: ENV.fetch("FASTLANE_ISSUER_ID"),
    key: File.read(ENV.fetch("FASTLANE_API_KEY_PATH")),
    duration: 1200,
    in_house: false
  }
  cert(development: true, api_key: api_key, team_id: ENV.fetch("FASTLANE_TEAM_ID"), force: true)
  puts "✅ 已生成/导入 #{ENV.fetch('FASTLANE_TEAM_ID')} 的 Apple Development 证书"
end
